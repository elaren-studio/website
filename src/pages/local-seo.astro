---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import InquiryComposer from "../components/InquiryComposer.astro";
import MarketingResources from "../components/MarketingResources.astro";
import { PRICING } from "../lib/marketing";

const description = "A bounded local SEO engagement for one Arlington or Dallas–Fort Worth business website and location, with practical page and Search Console improvements.";
const faqs = [
 ["Do I need a Google Business Profile?", "An existing, eligible profile is optional. If an online-only business does not have one, we proceed with the website scope only. We do not promise eligibility or Google verification."],
 ["What is included in month one?", "A keyword and search-intention map for up to ten queries, a Google Search Console baseline and sitemap check, two existing service-page updates up to 1,000 words each with titles, metas, and internal links, one review of an existing eligible profile, one kickoff, one consolidated revision, and a report."],
 ["What is month two and beyond?", "Optional continuation includes two existing page updates, a Search Console review, an eligible profile check, and a report. It is month to month with no automatic renewal."],
 ["Do you guarantee rankings, leads, or AI citations?", "No. Search visibility depends on many factors. We provide a defined review and implementation scope without outcome guarantees."],
];
const schema = { "@context": "https://schema.org", "@type": "Service", name: "Elaren local SEO", serviceType: "Local SEO", provider: { "@type": "Organization", name: "Elaren Studio", url: "https://elarenstudio.com" }, areaServed: ["Arlington, Texas", "Dallas–Fort Worth, Texas", "Texas (remote)"], offers: [{ "@type": "Offer", price: String(PRICING.intro), priceCurrency: "USD", description: `Alternative first-month engagement for one website and location; first ${PRICING.launchClients} new marketing clients; paid in advance after written scope.` }, { "@type": "Offer", price: String(PRICING.monthly), priceCurrency: "USD", description: `Optional month-to-month continuation with two existing page updates, held ${PRICING.priceHoldMonths} months for launch clients.` }], url: "https://elarenstudio.com/local-seo/" };
---
<BaseLayout title="Local SEO Arlington and DFW" description={description}>
 <Header />
 <main>
  <section class="container py-8 md:py-12"><Breadcrumbs items={[{ label: "Services", href: "/services" }, { label: "Local SEO" }]} /></section>
  <section class="container pb-16 md:pb-24"><div class="max-w-3xl">
   <p class="mb-3 text-sm font-medium uppercase tracking-wider text-accent">Local SEO · Arlington, DFW, and Texas remote</p>
   <h1 class="mb-6 text-4xl font-semibold text-ink md:text-5xl">Local SEO for Arlington and Dallas–Fort Worth.</h1>
   <p class="text-xl leading-relaxed text-ink/80">Help potential customers understand what you do and where you work. We improve two existing service pages, review your search visibility, and give you a clear first month of work before you decide whether to continue.</p>
   <div class="mt-8 rounded-xl border-2 border-accent/30 bg-accent/5 p-6"><p class="text-3xl font-semibold text-ink">${PRICING.intro} <span class="text-lg font-normal">for the first month</span></p><p class="mt-2 text-ink/75">Available to the first {PRICING.launchClients} new marketing clients total across content/social and local SEO. Continue at ${PRICING.monthly}/month, held for {PRICING.priceHoldMonths} months. No setup fee. Month to month, with no automatic renewal.</p></div>
   <div class="mt-7 flex flex-wrap gap-4"><a href="#inquiry" class="inline-flex rounded-xl bg-accent px-6 py-3 font-semibold text-paper no-underline shadow-lg shadow-accent/30">Check local SEO fit</a><a href="/content-marketing" class="inline-flex items-center font-semibold text-accent hover:underline">Compare the publishing package →</a></div>
  </div></section>
  <section class="bg-[var(--clr-muted)] py-16 md:py-20"><div class="container grid gap-8 md:grid-cols-2"><div><h2 class="mb-5 text-3xl font-semibold text-ink">Month-one scope</h2><ul class="space-y-3 text-ink/80">{["One website and one business location", "Keyword and intent map for up to ten queries", "Google Search Console baseline and sitemap check", "Two existing service-page updates, up to 1,000 words each, with titles, metas, and internal links", "Review of one existing eligible Google Business Profile and factual change proposals", "One 30-minute kickoff, one consolidated revision, and a monthly report"].map((item) => <li class="flex gap-3"><span class="text-accent" aria-hidden="true">✓</span><span>{item}</span></li>)}</ul></div><div class="rounded-xl border-2 border-slate-200 bg-paper p-7"><h2 class="mb-4 text-2xl font-semibold text-ink">Optional continuation</h2><p class="leading-relaxed text-ink/75">Each continuing month includes two existing-page updates up to 1,000 words each, a Search Console review, an eligible profile check, and a report at ${PRICING.monthly}/month. Any Business Profile publication requires owner approval first.</p><p class="mt-5 text-sm text-ink/65">Online-only businesses proceed website only when a profile is not available. We do not claim profile eligibility.</p></div></div></section>
  <section class="container py-16 md:py-24"><div class="grid gap-10 md:grid-cols-2"><div><h2 class="mb-5 text-3xl font-semibold text-ink">A clear before-and-after example</h2><div class="rounded-xl border border-slate-200 bg-paper p-6"><p class="text-sm uppercase tracking-wide text-ink/55">Fictional Arlington example</p><p class="mt-4 font-semibold text-ink">Before: “Services | Reliable help for your home”</p><p class="mt-2 text-ink/70">After: “Appliance repair in Arlington | Northside Home Repair” with a specific service description, one relevant internal link, and a factual meta description.</p><p class="mt-4 text-sm text-ink/60">This illustrates the work only. It is not a client result or ranking claim.</p></div><h2 class="mt-10 mb-4 text-3xl font-semibold text-ink">Explicit boundaries</h2><p class="leading-relaxed text-ink/75">No backlink building, citation clean-up at scale, tracking vendors or paid tools, site rebuilds, technical migrations, social or email work, Google verification guarantee, or ranking, lead, or AI-citation guarantee.</p></div><div><h2 class="mb-5 text-3xl font-semibold text-ink">Check fit before access</h2><p class="mb-6 leading-relaxed text-ink/75">Share your public website, business location, service area, and whether an eligible profile already exists. We confirm the pages, queries, and draft dates in writing before an advance payment. Page and Business Profile changes are published only after your approval.</p><InquiryComposer service="local-seo" />{faqs.map(([q, a]) => <details class="border-b border-slate-200 py-4"><summary class="cursor-pointer font-semibold text-ink">{q}</summary><p class="mt-3 text-ink/75">{a}</p></details>)}</div></div></section>
  <section class="container border-t border-slate-100 py-12"><p class="text-sm text-ink/65">Need coordinated website, social, and email publishing instead? See <a href="/content-marketing" class="text-accent hover:underline">content marketing</a>.</p></section>
  <MarketingResources />
 </main><Footer />
 <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</BaseLayout>
