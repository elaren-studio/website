---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import InquiryComposer from "../components/InquiryComposer.astro";
import MarketingResources from "../components/MarketingResources.astro";
import { CONTENT_BOUNDARIES, CONTENT_PACKAGE, PRICING } from "../lib/marketing";

const description = "A focused content marketing package for Dallas–Fort Worth organizations that need useful website, social, and email publishing.";
const faqs = [
 ["Who is this for?", "Small organizations with an existing website, at least one existing social platform, and a clear audience or campaign to serve. We work with DFW organizations and Texas teams remotely."],
 ["What does the first month cost?", `The first ${PRICING.launchClients} new marketing clients can start at $${PRICING.intro} for month one. Continuing clients pay $${PRICING.monthly}/month, with that rate held for ${PRICING.priceHoldMonths} months.`],
 ["How do approvals and billing work?", "We agree on written scope before work begins. The month is paid in advance, includes one consolidated revision, and is month to month with no automatic renewal."],
 ["Do you guarantee traffic or sales?", "No. We promise a defined publishing batch and clear communication, not rankings, leads, sales, or AI citation outcomes."],
];
const schema = { "@context": "https://schema.org", "@type": "Service", name: "Elaren content marketing", serviceType: "Content marketing", provider: { "@type": "Organization", name: "Elaren Studio", url: "https://elarenstudio.com" }, areaServed: ["Dallas–Fort Worth, Texas", "Texas (remote)"], offers: [{ "@type": "Offer", price: String(PRICING.intro), priceCurrency: "USD", description: `First month for the first ${PRICING.launchClients} new marketing clients; paid in advance after written scope.` }, { "@type": "Offer", price: String(PRICING.monthly), priceCurrency: "USD", description: `Optional month-to-month continuation; introductory clients keep this price for ${PRICING.priceHoldMonths} months.` }], url: "https://elarenstudio.com/content-marketing/" };
---
<BaseLayout title="Content Marketing DFW" description={description}>
 <Header />
 <main>
  <section class="container py-8 md:py-12"><Breadcrumbs items={[{ label: "Services", href: "/services" }, { label: "Content marketing" }]} /></section>
  <section class="container pb-16 md:pb-24"><div class="max-w-3xl">
   <p class="mb-3 text-sm font-medium uppercase tracking-wider text-accent">Content marketing · Dallas–Fort Worth and Texas remote</p>
   <h1 class="mb-6 text-4xl font-semibold text-ink md:text-5xl">Content marketing for Dallas–Fort Worth organizations.</h1>
   <p class="text-xl leading-relaxed text-ink/80">We plan and produce one coordinated monthly batch across your website, social channels, and email. You get clear scope, thoughtful writing, and publishing support without hiring a full marketing department.</p>
   <div class="mt-8 rounded-xl border-2 border-accent/30 bg-accent/5 p-6"><p class="text-3xl font-semibold text-ink">${PRICING.intro} <span class="text-lg font-normal">for month one</span></p><p class="mt-2 text-ink/75">Available to the first {PRICING.launchClients} new marketing clients total across content/social and local SEO. Continue at ${PRICING.monthly}/month, held for {PRICING.priceHoldMonths} months. No setup fee.</p></div>
   <div class="mt-7 flex flex-wrap gap-4"><a href="#inquiry" class="inline-flex rounded-xl bg-accent px-6 py-3 font-semibold text-paper no-underline shadow-lg shadow-accent/30">Check fit</a><a href="/work-examples/program-campaign" class="inline-flex items-center font-semibold text-accent hover:underline">See a fictional campaign example →</a></div>
  </div></section>
  <section class="bg-[var(--clr-muted)] py-16 md:py-20"><div class="container grid gap-8 md:grid-cols-2"><div><h2 class="mb-5 text-3xl font-semibold text-ink">One package, coordinated</h2><ul class="space-y-3 text-ink/80">{CONTENT_PACKAGE.map((item) => <li class="flex gap-3"><span class="text-accent" aria-hidden="true">✓</span><span>{item}</span></li>)}</ul></div><div class="rounded-xl border-2 border-slate-200 bg-paper p-7"><h2 class="mb-4 text-2xl font-semibold text-ink">What stays outside the scope</h2><ul class="space-y-3 text-ink/75">{CONTENT_BOUNDARIES.map((item) => <li class="flex gap-3"><span aria-hidden="true">•</span><span>{item}</span></li>)}</ul><p class="mt-5 text-sm text-ink/65">The twelve social posts and one email are included in this package. Local SEO is a separate option with its own scope.</p></div></div></section>
  <section class="container py-16 md:py-24"><div class="grid gap-10 md:grid-cols-[1fr_0.9fr]"><div><h2 class="mb-4 text-3xl font-semibold text-ink">Start with a fit check</h2><p class="mb-6 leading-relaxed text-ink/75">Share your public website, existing channels, campaign goal, and target month. We confirm the written scope before any paid work. Texas teams can work with us remotely.</p><InquiryComposer service="content-marketing" /></div><div><h2 class="mb-5 text-3xl font-semibold text-ink">Questions, answered</h2>{faqs.map(([q, a]) => <details class="border-b border-slate-200 py-4"><summary class="cursor-pointer font-semibold text-ink">{q}</summary><p class="mt-3 text-ink/75">{a}</p></details>)}</div></div></section>
  <section class="container border-t border-slate-100 py-12"><p class="text-sm text-ink/65">Looking specifically for social planning? See <a href="/social-media-marketing" class="text-accent hover:underline">social content and scheduling</a>. For search-only work, compare <a href="/local-seo" class="text-accent hover:underline">Local SEO for Arlington and DFW</a>.</p></section>
  <section class="container pb-16">
   <div class="max-w-3xl rounded-xl border-2 border-slate-200 bg-paper p-7">
    <p class="text-sm font-medium uppercase tracking-wide text-accent">Fictional writing sample</p>
    <h2 class="mt-3 text-2xl font-semibold text-ink">A place to make something of your own.</h2>
    <p class="mt-4 leading-relaxed text-ink/80">Six free Saturday arts sessions for Arlington students ages 10–14. Explore visual art with a teaching artist, try new materials, and develop your own ideas. No prior experience is needed.</p>
    <p class="mt-4 text-sm leading-relaxed text-ink/65">An excerpt from our invented Northside Arts Workshop brief, showing how we put audience, offer, and fit into a short introduction. This is a demonstration, not a real event or client result.</p>
    <a href="/work-examples/program-campaign" class="mt-4 inline-block font-semibold text-accent hover:underline">See the connected website, email, and social example →</a>
   </div>
  </section>
  <MarketingResources />
 </main><Footer />
 <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</BaseLayout>
